JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./secure_exam.db
KEY_DIR=./keys
AUTHORITY_PRIVATE_KEY=./keys/authority_private.pem
AUTHORITY_PUBLIC_KEY=./keys/authority_public.pem

# Phase 9: blockchain backend
BLOCKCHAIN_BACKEND=local

# Hyperledger Fabric (required only when BLOCKCHAIN_BACKEND=fabric)
FABRIC_CHANNEL=examchannel
FABRIC_CHAINCODE=secureexam
FABRIC_MSP_ID=ExamAuthorityMSP
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=
FABRIC_PEER_ENDPOINT=

EXAM_RELEASE_WINDOW_MINUTES=15
EXAM_REQUIRED_RELEASE_APPROVALS=2
